{
  "openapi": "3.1.0",
  "info": {
    "title": "Kolyan Minimal Server API",
    "version": "1.0.0",
    "description": "Loopback complete-result HTTP boundary. No event streaming or command replay."
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/sessions": {
      "post": {
        "operationId": "createSession",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSession"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Session created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionView"
                }
              }
            }
          },
          "default": {
            "description": "Safe error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/sessions/{session_id}": {
      "parameters": [
        {
          "name": "session_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_-]+$"
          }
        }
      ],
      "get": {
        "operationId": "getSession",
        "responses": {
          "200": {
            "description": "Current complete view",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionView"
                }
              }
            }
          },
          "default": {
            "description": "Safe error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/sessions/{session_id}/turns": {
      "parameters": [
        {
          "name": "session_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_-]+$"
          }
        }
      ],
      "post": {
        "operationId": "startTurn",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StartTurn"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Current complete view",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TurnView"
                }
              }
            }
          },
          "default": {
            "description": "Safe error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/sessions/{session_id}/turns/{turn_id}": {
      "parameters": [
        {
          "name": "session_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_-]+$"
          }
        },
        {
          "name": "turn_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_-]+$"
          }
        }
      ],
      "get": {
        "operationId": "getTurn",
        "responses": {
          "200": {
            "description": "Current complete view",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TurnView"
                }
              }
            }
          },
          "default": {
            "description": "Safe error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/sessions/{session_id}/turns/{turn_id}/approvals/{approval_id}/decision": {
      "parameters": [
        {
          "name": "session_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_-]+$"
          }
        },
        {
          "name": "turn_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_-]+$"
          }
        },
        {
          "name": "approval_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "minLength": 1
          }
        }
      ],
      "post": {
        "operationId": "decideApproval",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Decision"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Current complete view",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TurnView"
                }
              }
            }
          },
          "default": {
            "description": "Safe error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/sessions/{session_id}/turns/{turn_id}/cancel": {
      "parameters": [
        {
          "name": "session_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_-]+$"
          }
        },
        {
          "name": "turn_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_-]+$"
          }
        }
      ],
      "post": {
        "operationId": "cancelTurn",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Empty"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Current complete view",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TurnView"
                }
              }
            }
          },
          "default": {
            "description": "Safe error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "CreateSession": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "session_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_-]+$"
          }
        },
        "required": [
          "session_id"
        ]
      },
      "StartTurn": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "turn_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "input": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32768
          }
        },
        "required": [
          "turn_id",
          "input"
        ]
      },
      "Decision": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "decision": {
            "type": "string",
            "enum": [
              "approve",
              "deny"
            ]
          }
        },
        "required": [
          "decision"
        ]
      },
      "Empty": {
        "type": "object",
        "additionalProperties": false,
        "properties": {},
        "required": []
      },
      "SessionView": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "session_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "version": {
            "type": "integer",
            "minimum": 0
          },
          "turns": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "turn_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9_-]+$"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "running",
                    "suspended",
                    "completed",
                    "cancelled",
                    "failed"
                  ]
                }
              },
              "required": [
                "turn_id",
                "status"
              ]
            }
          }
        },
        "required": [
          "session_id",
          "version",
          "turns"
        ]
      },
      "StepView": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "step_id": {
            "type": "string"
          },
          "outcome": {
            "type": "string",
            "enum": [
              "FinalAnswer",
              "ToolCalls",
              "Refused",
              "Incomplete"
            ]
          },
          "content": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DisplayContent"
            }
          },
          "usage": {
            "$ref": "#/components/schemas/Usage"
          },
          "structured_output": {}
        },
        "required": [
          "step_id",
          "outcome",
          "content",
          "usage",
          "structured_output"
        ]
      },
      "DisplayContent": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "text"
              },
              "text": {
                "type": "string"
              }
            },
            "required": [
              "type",
              "text"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "reasoning"
              },
              "text": {
                "type": "string"
              }
            },
            "required": [
              "type",
              "text"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "tool_call"
              },
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "arguments": {}
            },
            "required": [
              "type",
              "id",
              "name",
              "arguments"
            ]
          }
        ]
      },
      "Usage": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "input_tokens": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "output_tokens": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "cache_read_tokens": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "cache_write_tokens": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "reasoning_tokens": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          }
        },
        "required": [
          "input_tokens",
          "output_tokens",
          "cache_read_tokens",
          "cache_write_tokens",
          "reasoning_tokens"
        ]
      },
      "Approval": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "approval_id": {
            "type": "string"
          },
          "call_id": {
            "type": "string"
          },
          "tool_name": {
            "type": "string"
          },
          "arguments": {}
        },
        "required": [
          "approval_id",
          "call_id",
          "tool_name",
          "arguments"
        ]
      },
      "TurnView": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "session_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "turn_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "state": {
            "type": "string",
            "enum": [
              "running",
              "suspended",
              "completed",
              "cancelled",
              "failed"
            ]
          },
          "end_reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "steps": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StepView"
            }
          },
          "pending_approval": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Approval"
              },
              {
                "type": "null"
              }
            ]
          },
          "cancellation_requested": {
            "type": "boolean"
          },
          "execution_stopped": {
            "type": "boolean"
          },
          "recovery_required": {
            "type": "boolean"
          },
          "tool_results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ToolResult"
            }
          }
        },
        "required": [
          "session_id",
          "turn_id",
          "state",
          "end_reason",
          "steps",
          "pending_approval",
          "cancellation_requested",
          "execution_stopped",
          "recovery_required",
          "tool_results"
        ]
      },
      "Problem": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "code": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code",
          "detail"
        ]
      },
      "ToolResult": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "call_id": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "is_error": {
            "type": "boolean"
          }
        },
        "required": [
          "call_id",
          "content",
          "is_error"
        ]
      }
    }
  }
}
