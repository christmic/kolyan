{
  "request": {
    "request_id": "live-tool-call-001",
    "system": "你可以调用 get_weather 工具查询指定城市的当前天气；如果不调用工具，直接告诉用户「未提供该城市的数据」。",
    "messages": [
      {
        "role": "user",
        "content": [
          { "type": "text", "text": "北京今天的天气怎么样？" }
        ]
      }
    ],
    "tools": [
      {
        "name": "get_weather",
        "description": "查询指定城市的天气，返回简短描述。",
        "input_schema": {
          "type": "object",
          "properties": {
            "city": {
              "type": "string",
              "description": "城市中文名，例如 北京 / 上海 / 青岛"
            }
          },
          "required": ["city"]
        }
      }
    ],
    "tool_choice": "auto",
    "max_output_tokens": 256
  },
  "expectations": {
    "stop_reason": "tool_use",
    "tool_call": {
      "name": "get_weather",
      "arguments": {
        "type": "object",
        "required": ["city"],
        "properties": {
          "city": { "type": "string", "min_len": 1 }
        }
      }
    },
    "requires": []
  }
}
